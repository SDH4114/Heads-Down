{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.3.3",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "heads-down@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/matcher.js",
      "src/lock.js",
      "src/pomodoro.js",
      "src/i18n.js",
      "src/policy.js",
      "src/storage.js",
      "src/background.js"
    ]
  },
  "browser_action": {
    "default_title": "__MSG_extName__",
    "default_popup": "ui/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": ["ui/blocked.html"]
}
